terminal_list regex.mlex
type_returned astnode
sp ::= regex
regex ::= regex OR catexpr @mkOr
regex ::= catexpr
catexpr ::= catexpr repexpr @mkConcat
catexpr ::= repexpr 
repexpr ::= val KLEENE_STAR  @mkKleene
repexpr ::= val KLEENE_PLUS  @mkKleene
repexpr ::= val QMARK   @mkOpt
repexpr ::= val
val ::= LPAREN regex RPAREN  @pass
val ::= LETTER               @mkLeaf
val ::= PERIOD               @mkLeaf
val ::= LSQB optneg cclist RSQB     @mkCcl
optneg ::= NEGATE
optneg ::= #
cclist ::= cclist ccent      @mkList
cclist ::= ccent
ccent ::= LETTER DASH LETTER  @mkCCLRange
ccent ::= LETTER